---
import { categories, documents } from '../data/documents';
---
<div class="category-grid">
    {categories.map((category, index) => <a class="category-card" href={`/collections/${category.slug}`}>
        <span class="category-meta"><span>COLLECTION / 0{index + 1}</span><span>{documents.filter(document => document.slug.startsWith(`${category.slug}/`)).length} documents</span></span>
        <h3>{category.label}</h3>
        <p>{category.description}</p>
        <span class="category-action">View documents <span aria-hidden="true">→</span></span>
    </a>)}
</div>
