---
interface Props { currentSlug?: string; }
const { currentSlug } = Astro.props;
const categories = [
    ['technical-writing', 'Technical writing', 'API references, architecture, user guides, and operational documentation.'],
    ['docs-as-code', 'Docs-as-code & strategy', 'Content standards, contribution guidelines, and publishing workflows.'],
    ['knowledge-management', 'Knowledge management', 'Knowledge base structure, taxonomy, and content governance.'],
    ['ai-assisted-documentation', 'AI-assisted documentation', 'Prompt libraries, AI workflows, and human review practices.'],
    ['case-studies', 'Case studies', 'Documentation modernization and content migration approaches.'],
];
const files = import.meta.glob('../content/*/*', { query: '?raw', import: 'default', eager: true });
const documents = Object.entries(files)
    .filter(([path, content]) => !/\.(md|pdf)$/.test(path) && String(content).trim())
    .map(([path, content]) => {
        const slug = path.split('/content/')[1];
        const title = String(content).split('\n').find(line => line.startsWith('# '))?.slice(2).trim();
        return { slug, title: title || slug.split('/')[1].replaceAll('-', ' ') };
    }).sort((a, b) => {
        if (a.slug.endsWith('/readme')) return -1;
        if (b.slug.endsWith('/readme')) return 1;
        return a.title.localeCompare(b.title);
    });
---
<div class="document-directory">
    {categories.map(([slug, label, description]) => {
        const entries = documents.filter(document => document.slug.startsWith(`${slug}/`));
        return <details open={currentSlug?.startsWith(`${slug}/`)}>
            <summary><span class="category-copy"><strong>{label}</strong><span>{description}</span></span><span class="document-count">{entries.length} documents</span><span class="directory-toggle" aria-hidden="true">+</span></summary>
            <ul>{entries.map(document => <li><a href={`/work/${document.slug}`} aria-current={currentSlug === document.slug ? 'page' : undefined}>{document.title}<span aria-hidden="true">↗</span></a></li>)}</ul>
        </details>;
    })}
</div>
