---
import Layout from '../../layouts/Layout.astro';
import { Marked } from 'marked';
import architectureImage from '../../assets/omnilib-arch-diagram.jpeg';
import pipelineImage from '../../assets/automated-pipeline-flow.jpeg';
const files = import.meta.glob('../../content/*/*', { query: '?raw', import: 'default', eager: true });
export function getStaticPaths() {
const docs = import.meta.glob('../../content/*/*', { query: '?raw', import: 'default', eager: true });
return Object.entries(docs).filter(([path]) => !path.endsWith('.pdf') && !path.endsWith('.md')).map(([path,content]) => ({params:{slug:path.split('/content/')[1]}, props:{content, category:path.split('/content/')[1].split('/')[0]}}));
}
const { content, category } = Astro.props;
const related = Object.entries(files).filter(([path]) => path.includes(`/content/${category}/`) && !path.endsWith('.pdf') && !path.endsWith('.md'));
const labels: Record<string,string> = { 'readme':'Project overview', 'api-reference':'API reference', 'architecture-spec':'Architecture specification', 'installation-ops-guide':'Installation & operations', 'user-guide':'User guide', 'librarian-runbook':'Librarian runbook', 'troubleshooting-guide':'Troubleshooting', 'release-notes':'Release notes' };
let source = String(content).replace(/\{:\s*target="_blank"\}/g,'');
const aliases: Record<string,string> = {'01-architecture-spec':'architecture-spec','02-api-reference':'api-reference','03-installation-ops-guide':'installation-ops-guide','04-librarian-runbook':'librarian-runbook','05-end-user-guide':'user-guide','06-troubleshooting-matrix':'troubleshooting-guide','knowledge-base-structure':'knowledgebase-structure'};
source = source.replace(/\]\(([^)]+)\)/g, (match, url) => {
if (/^(https?:|#)/.test(url)) return match;
if (/\.(jpeg|jpg|png)$/.test(url)) return `](${url.includes('pipeline') ? pipelineImage.src : architectureImage.src})`;
const basename = url.split('/').pop().replace(/\.md$/,'');
const name = aliases[basename] || basename;
const found = Object.keys(files).find(path => path.endsWith(`/${name}`));
return found ? `](/work/${found.split('/content/')[1]})` : match;
});
const html = await new Marked().parse(source);
const title = String(content).split('\n').find(line => line.startsWith('# '))?.replace(/^# /,'') || category;
---
<Layout title={`${title} — Dhara Gohil`}><article class="document wrap"><a class="document-back" href="/#work">← Back to selected work</a><p class="eyebrow">WRITING SAMPLE / {category.replaceAll('-',' ').toUpperCase()}</p><div class="prose" set:html={html}></div><nav class="sample-nav" aria-label="Related writing samples"><h2>Explore this collection</h2><div>{related.map(([path]) => {const slug = path.split('/content/')[1]; const name = slug.split('/')[1];return <a href={`/work/${slug}`} aria-current={Astro.params.slug === slug ? 'page' : undefined}>{labels[name] || name.replaceAll('-',' ')}</a>})}</div></nav></article></Layout>
