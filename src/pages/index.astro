import Layout from '../layouts/Layout.astro';
const projects = [
{n:'01', category:'technical', type:'TECHNICAL WRITING', title:'Complex systems. Clear documentation.', description:'A complete documentation suite for OmniLib House — from architecture and API references to everyday user guides.', tags:['API documentation','User guides','Architecture'], href:'/work/technical-writing/readme', art:'docs', label:'OmniLib House', sub:'DOCUMENTATION THAT CONNECTS THE DOTS'},
{n:'02', category:'strategy', type:'DOCS-AS-CODE & STRATEGY', title:'Good documentation starts with a system.', description:'Scalable workflows, contribution guidelines, and content standards built for the way engineering teams work.',tags:['Docs-as-code','Content operations','Git'],href:'/work/docs-as-code/documentation-strategy',art:'flow',label:'From commit to clarity',sub:'A BETTER WAY TO BUILD DOCUMENTATION'},
{n:'03',category:'knowledge',type:'KNOWLEDGE MANAGEMENT',title:'The right knowledge. Within reach.',description:'Information architecture, thoughtful taxonomies, and governance that turn scattered information into shared knowledge.',tags:['Information architecture','Taxonomy','Governance'],href:'/work/knowledge-management/knowledgebase-structure',art:'knowledge',label:'A place for every answer',sub:'ORGANIZE. CONNECT. DISCOVER.'},
{n:'04',category:'ai',type:'AI-ASSISTED DOCUMENTATION',title:'Human judgment. AI possibility.',description:'Practical approaches to AI-assisted writing, with purposeful prompts, structured reviews, and people at the center.',tags:['AI workflows','Prompt engineering','Content quality'],href:'/work/ai-assisted-documentation/workflow',art:'ai',label:'A thoughtful collaboration',sub:'HUMAN EXPERTISE × AI ASSISTANCE'}
